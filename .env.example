# Cópia este arquivo como ".env" pra dev local.
# Em prod (Vercel), defina essas variáveis pelo painel ou pelo `vercel env`.

# Porta do servidor local (default 5555)
PORTA=5555

# Chave secreta da app — gere algo forte em produção
SECRET_KEY=troque-isso-em-producao

# Banco de dados.
# Dev (SQLite, default):
DATABASE_URL=sqlite:///educamais.db
# Prod (Postgres do Supabase — use o pooler em modo "transaction" porta 6543):
# DATABASE_URL=postgresql+psycopg2://postgres.SEU_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Storage de uploads.
#  - "local"     → grava em app/static/uploads/ (default em dev)
#  - "supabase"  → envia pro bucket configurado abaixo
STORAGE_BACKEND=local

# Quando STORAGE_BACKEND=supabase, configure também:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# Backup local (zip do .db + uploads). Defina como "false" em prod.
BACKUP_ENABLED=true

# Modo do cliente Cora (mock | real). "real" ainda não está implementado.
CORA_MODE=mock
