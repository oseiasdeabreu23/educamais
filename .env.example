# Cópia este arquivo como ".env" pra dev local.
# Em prod (Vercel), defina essas variáveis pelo painel ou pelo `vercel env`.

# Porta do servidor local (default 5555)
PORTA=5555

# Chave secreta da app — gere algo forte em produção
SECRET_KEY=troque-isso-em-producao

# Banco de dados.
# Dev (SQLite, default):
DATABASE_URL=sqlite:///educamais.db
# Prod (Postgres do Supabase — use o pooler em modo "transaction" porta 6543):
# DATABASE_URL=postgresql+psycopg2://postgres.SEU_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Storage de uploads.
#  - "local"     → grava em app/static/uploads/ (default em dev)
#  - "supabase"  → envia pro bucket configurado abaixo
STORAGE_BACKEND=local

# Quando STORAGE_BACKEND=supabase, configure também:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# Backup local (zip do .db + uploads). Defina como "false" em prod.
BACKUP_ENABLED=true

# Modo do cliente Cora (mock | real). "real" ainda não está implementado.
CORA_MODE=mock

# ── Painel de Licenças ─────────────────────────────────────────────────
# Integração com o painel externo de licenças. A API key, documento,
# tipo de cliente e modo são configurados pela UI em /admin/licenca
# (vivem no banco, não em arquivo). Aqui ficam só parâmetros técnicos.
PAINEL_LICENCA_URL=https://painel-licencas-rho.vercel.app
PAINEL_LICENCA_CACHE_HORAS=6
PAINEL_LICENCA_GRACE_DIAS=3
# (Opcional) Força um resultado sem bater no painel — útil pra testar
# branches: ativo|vencido|pendente|suspenso|bloqueado|cancelado|
# nao_encontrado|limite_excedido|offline_grace_expirado|erro_rede.
# Deixe vazio em produção.
PAINEL_LICENCA_DEBUG_RESULTADO=
